#!/bin/sh
set -eu

export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
export LANG=C.UTF-8
export LC_ALL=C.UTF-8
export DEBIAN_FRONTEND=noninteractive

# network-manager-gnome can pull GNOME Shell when it is resolved before the
# XFCE policy and notification providers. Remove that unintended session from
# old/cached builds; fresh builds avoid installing it through package layering.
set --
for package in gdm3 ubuntu-session gnome-shell; do
    if dpkg-query -W -f='${db:Status-Abbrev}' "$package" 2>/dev/null |
        grep -q '^ii'; then
        set -- "$@" "$package"
    fi
done
if [ "$#" -gt 0 ]; then
    apt-get purge -y "$@"
fi

systemctl disable gdm3.service 2>/dev/null || true
systemctl enable lightdm.service
systemctl enable NetworkManager.service
systemctl set-default graphical.target

printf '%s\n' /usr/sbin/lightdm > /etc/X11/default-display-manager

if [ -d /usr/share/backgrounds ]; then
    find /usr/share/backgrounds \
        -mindepth 1 \
        -maxdepth 1 \
        ! -name raven \
        -exec rm -rf -- {} +
fi

# Remove generic XFCE backdrops.
if [ -d /usr/share/xfce4/backdrops ]; then
    find /usr/share/xfce4/backdrops \
        -mindepth 1 \
        -maxdepth 1 \
        -exec rm -f -- {} +
fi

find /etc/xdg \
    -type f \
    -name xfce4-desktop.xml \
    -exec sed -i \
        's|/usr/share/xfce4/backdrops/xubuntu-wallpaper.png|/usr/share/backgrounds/raven/background.jpg|g' \
        {} +

if [ -d /usr/share/desktop-base ]; then
    find /usr/share/desktop-base \
        -mindepth 2 \
        -maxdepth 2 \
        \( -name wallpaper -o -name wallpaper-withlogo \
           -o -name lockscreen -o -name login \) \
        -exec rm -rf -- {} +
fi

if [ -d /usr/share/gnome-background-properties ]; then
    find /usr/share/gnome-background-properties \
        -mindepth 1 \
        -maxdepth 1 \
        -type f \
        \( -name 'debian-*.xml' -o -name 'ubuntu-wallpapers.xml' \
           -o -name 'noble-wallpapers.xml' -o -name 'greybird.xml' \) \
        -delete
fi

# Drop vendor greeter defaults that refer to the removed Ubuntu/Xubuntu files.
rm -f \
    /usr/share/lightdm/lightdm-gtk-greeter.conf.d/01_ubuntu.conf \
    /usr/share/lightdm/lightdm-gtk-greeter.conf.d/30_xubuntu.conf

# Ensure Raven OS wallpapers have standard readable permissions.
find /usr/share/backgrounds/raven \
    -type f \
    -exec chmod 0644 {} +

update-desktop-database || true
update-icon-caches /usr/share/icons/* || true
